{
  "name": "amberone",
  "version": "1.0.0",
  "private": true,
  "description": "AmberOne — One Assistant. One Place. One Life.",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev . --d1=DB=amberone --local --port 8788",
    "build": "node scripts/build-check.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute amberone --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute amberone --remote --file=./schema.sql",
    "stripe:catalog": "node scripts/stripe-catalog.mjs",
    "deploy": "node scripts/pages-create-deploy.mjs",
    "secrets:push": "node scripts/push-pages-secrets.mjs",
    "test:password": "node scripts/password-migration.test.mjs",
    "test:auth": "node scripts/auth-hardening.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:e2e": "node scripts/e2e-customer-journey.mjs",
    "verify:phase1": "node scripts/verify-phase1-core.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250726.0",
    "playwright": "^1.52.0",
    "typescript": "^5.8.3",
    "wrangler": "3.114.15"
  }
}
