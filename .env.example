# Copy to .dev.vars for local Pages Functions (never commit secrets)

# Required for live Stripe Checkout / Customer Portal / webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: preferred Stripe Price IDs (created by npm run stripe:catalog)
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_FAMILY_2=
STRIPE_PRICE_FAMILY_5=
STRIPE_PRICE_FAMILY_10=
STRIPE_PRICE_EXECUTIVE=
STRIPE_PRICE_BUSINESS_SMALL=
STRIPE_PRICE_BUSINESS_MEDIUM=

# Optional: password-reset email delivery (without this, reset tokens are returned in API for owner setup only)
RESEND_API_KEY=
EMAIL_FROM=AmberOne <noreply@amberone.app>

# Optional: Talk to Amber (falls back to guided FAQ without this)
OPENAI_API_KEY=
